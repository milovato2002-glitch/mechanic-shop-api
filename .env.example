# Local development environment variables. Copy to .env and fill in.

# Option 1: full SQLAlchemy URI (takes priority)
# SQLALCHEMY_DATABASE_URI=mysql+mysqlconnector://root:password@localhost/mechanic_shop_db

# Option 2: Render/Heroku-style Postgres URL
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Flask
SECRET_KEY=change-me-in-production
